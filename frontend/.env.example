# PulseRoute Frontend Environment Variables
# For local development:
VITE_API_URL=http://localhost:8000

# For production deployment (e.g., Render/Railway/Fly backend):
# VITE_API_URL=https://pulseroute-backend.onrender.com

# Optional Tableau Public/Cloud embed URL for live interactive dashboard:
# If left unset or empty, the Tableau page displays the verified local workbook (Book3.twb) state
# VITE_TABLEAU_DASHBOARD_URL=https://public.tableau.com/views/YourWorkbook/Dashboard
